{
  "engine": {
    "target_fps": 60,
    "width": 1920,
    "height": 1080,
    "queue_maxsize": 120,
    "encoder_priority": [
      "h264_nvenc",
      "h264_mf",
      "h264_qsv",
      "libx264"
    ],
    "bitrate": "18M",
    "pix_fmt": "yuv420p"
  },
  "qa_gate": {
    "max_frame_drop_percent": 0.5,
    "require_ffprobe_clean": true,
    "require_order_confirmation": true
  },
  "paths": {
    "staging": "staging",
    "raw_recordings": "raw_recordings",
    "quarantine": "quarantine"
  }
}